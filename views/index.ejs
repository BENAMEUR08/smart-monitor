<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>🐔 Smart Farm Dashboard</title>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
  <h3>🐔 المزرعة الذكية</h3>
  <button onclick="logout()">تسجيل الخروج</button>
</header>

<div id="alertBox"></div>

<!-- ================= MENU ================= -->
<div id="menu" class="menu">
  
  <div class="icon-card" onclick="openPage('sensors')">
    <div class="icon">🌡️</div>
    <div class="title">الحساسات</div>
    <div class="sub">مراقبة الحرارة والرطوبة</div>
  </div>

  <div class="icon-card" onclick="openPage('limits')">
    <div class="icon">⚙️</div>
    <div class="title">الحدود</div>
    <div class="sub">إعدادات النظام</div>
  </div>

  <div class="icon-card" onclick="openPage('chart')">
    <div class="icon">📊</div>
    <div class="title">الرسم البياني</div>
    <div class="sub">تحليل البيانات</div>
  </div>

  <div class="icon-card live" onclick="goLive()">
    <div class="icon">📡</div>
    <div class="title">البث المباشر</div>
    <div class="sub">مشاهدة الكاميرا</div>
    <span class="pulse"></span>
  </div>
  
  <div class="icon-card" onclick="openPage('health')">
  <div class="icon">🧠</div>
  <div class="title">الحالة الصحية</div>
  <div class="sub">تحليل الدجاج بالذكاء الاصطناعي</div>
  </div>

  <div class="icon-card archive"
onclick="goArchive()">

<div class="icon">
📊
</div>

<div class="title">
الأرشيف
</div>

<div class="sub">
سجل الحساسات
</div>

<span class="pulse"></span>

</div>
</div>
<!-- ================= SENSORS ================= -->

<!-- ================= HEALTH AI ================= -->
<div id="health" class="section">

  <button onclick="backHome()">⬅ رجوع</button>

  <div class="container">

    <!-- رفع الصورة -->
    <div class="card">
      <h3>📤 رفع صورة</h3>
      <input type="file" id="imageInput" accept="image/*">
      <button onclick="sendImage()">تحليل</button>
    </div>

    <!-- عرض الصورة -->
    <div class="card">
      <h3>🖼️ الصورة</h3>
      <img id="preview" style="width:100%; border-radius:10px;">
    </div>

    <!-- النتيجة -->
    <div class="card result-card">
      <h3>📊 النتيجة</h3>
      <p id="healthStatus">---</p>
      <p id="healthConfidence"></p>
    </div>

  </div>

</div>

<div id="sensors" class="section">

  <button onclick="backHome()">⬅ رجوع</button>

  <div class="container">
    <div class="card">🌡 الحرارة <p id="temp">--</p></div>
    <div class="card">💧 الرطوبة <p id="hum">--</p></div>
    <div class="card">🌀 المروحة <p id="fan">--</p></div>
    <div class="card">🌬️ التهوية <p id="exhaustFan">--</p></div>
    <div class="card">🔥 السخان <p id="heater">--</p></div>
    <div class="card">🔥 النار <p id="fire">--</p></div>
    <div class="card">💦مرشة الحريق<p id="water">--</p></div>
  </div>

</div>

<!-- ================= LIMITS ================= -->
<div id="limits" class="section">

  <button onclick="backHome()">⬅ رجوع</button>

  <!-- ===== Limits Display Cards ===== -->
  <div class="container">

    <div class="card">
      🌡️ حدود الحرارة
      <p id="tempLimits">--</p>
    </div>
    <div class="card">
      💧 حدود الرطوبة
      <p id="humMaxDisplay">--</p>
    </div>
    
  </div>

  <hr style="margin:20px 0; opacity:0.2;">

  <!-- ===== Inputs ===== -->
  <div class="container">
    <div class="card">الحد الأدنى للحرارة <input id="tempMin"></div>
    <div class="card">الحد الأقصى للحرارة <input id="tempMax"></div>
    <div class="card">الحد الأقصى للرطوبة <input id="humMax"></div>
  </div>
  <button class="save-btn" onclick="sendLimits()">💾 حفظ</button>

</div>

<!-- ================= CHART ================= -->
<div id="chart" class="section">

  <button onclick="backHome()">⬅ رجوع</button>

  <div class="chart-box">
    <canvas id="chartCanvas"></canvas>
  </div>

</div>

<script src="app.js"></script>

</body>
</html>