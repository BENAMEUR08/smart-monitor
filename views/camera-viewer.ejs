<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>📡 البث المباشر</title>

<script src="/socket.io/socket.io.js"></script>

<style>
body{
  margin:0;
  background:#020617;
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
  font-family:'Cairo', sans-serif;
  color:white;
}

.container{
  width:90%;
  max-width:500px;
}

.header{
  text-align:center;
  margin-bottom:10px;
  font-size:20px;
  font-weight:bold;
}

.status{
  text-align:center;
  margin-bottom:10px;
  background:#333;
  padding:5px;
  border-radius:10px;
}

.live-on{
  background:red;
}

.video-box{
  height:300px;
  background:black;
  border-radius:20px;
  overflow:hidden;
  position:relative;
}

video{
  width:100%;
  height:100%;
  object-fit:cover;
}

.overlay{
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  display:flex;
  justify-content:center;
  align-items:center;
  background:rgba(0,0,0,0.6);
}

button{
  padding:12px;
  border:none;
  border-radius:10px;
  color:white;
  font-size:16px;
  cursor:pointer;
}

.play-btn{background:#16a34a;}

.controls{
  margin-top:10px;
  display:flex;
  gap:10px;
}
button{
  background:#ef4444;
  border:none;
  padding:8px 12px;
  color:white;
  border-radius:8px;
  cursor:pointer;
  margin:10px 0;
}
.start{background:#16a34a;}
.stop{background:#dc2626;}
</style>
</head>

<body>

<div class="container">

  <div class="top-bar">
  <button class="back-btn" onclick="goHome()">⬅ رجوع</button>
  <div class="header">📡 البث المباشر</div>
  </div>

  <div id="liveStatus" class="status">● غير متصل</div>

  <div class="video-box">
    <video id="remoteVideo" autoplay playsinline muted></video>

    <div id="videoOverlay" class="overlay">
      <button class="play-btn" onclick="startLive()">▶ تشغيل البث</button>
    </div>
  </div>

  <div class="controls">
    <button onclick="startLive()" class="start">تشغيل</button>
    <button onclick="stopLive()" class="stop">إيقاف</button>
    <button onclick="captureFrame()" style="background:#3b82f6;">📸 التقاط صورة</button>
  </div>

</div>
<canvas id="canvas" style="display:none;"></canvas>
<script>
// ================= SOCKET =================
const socket = io();

// ============================
// 🎥 WebRTC LIVE STREAM (نفس كودك)
// ============================

let pc = null;
let liveStarted = false;

const remoteVideo = document.getElementById("remoteVideo");
const liveStatus = document.getElementById("liveStatus");
const videoOverlay = document.getElementById("videoOverlay");

function startLive(){

  if(liveStarted) return;
  liveStarted = true;

  console.log("▶ بدء البث");

  remoteVideo.style.display = "block";

  try {
    if(liveStatus){
      liveStatus.innerHTML = "● مباشر";
      liveStatus.classList.add("live-on");
    }

    if(videoOverlay){
      videoOverlay.style.display = "none";
    }
  } catch(e){
    console.warn(e);
  }

  pc = new RTCPeerConnection({
    iceServers: [
      { urls: "stun:stun.relay.metered.ca:80" },
      {
        urls: "turn:global.relay.metered.ca:80",
        username: "6e0ed10751caa5b29fa3f324",
        credential: "IMpasbFjZaj7Sk3D",
      },
      {
        urls: "turn:global.relay.metered.ca:80?transport=tcp",
        username: "6e0ed10751caa5b29fa3f324",
        credential: "IMpasbFjZaj7Sk3D",
      },
      {
        urls: "turn:global.relay.metered.ca:443",
        username: "6e0ed10751caa5b29fa3f324",
        credential: "IMpasbFjZaj7Sk3D",
      },
      {
        urls: "turns:global.relay.metered.ca:443?transport=tcp",
        username: "6e0ed10751caa5b29fa3f324",
        credential: "IMpasbFjZaj7Sk3D",
      },
    ]
  });

  pc.ontrack = (event) => {
    console.log("📡 تم استقبال الفيديو");

    remoteVideo.srcObject = event.streams[0];

    remoteVideo.play().catch(()=>{});
  };

  pc.onicecandidate = (event) => {
    if(event.candidate){
      socket.emit("ice-candidate", event.candidate);
    }
  };

  socket.emit("viewer-joined");
}

socket.on("offer", async (offer) => {

  if(!pc){
    console.log("⚠️ تجاهل offer");
    return;
  }

  try{
    await pc.setRemoteDescription(offer);
    const answer = await pc.createAnswer();
    await pc.setLocalDescription(answer);
    socket.emit("answer", pc.localDescription);
  }catch(err){
    console.error(err);
  }
});

socket.on("ice-candidate", async (candidate) => {

  if(!pc) return;

  try{
    await pc.addIceCandidate(candidate);
  }catch(e){
    console.error(e);
  }
});

function stopLive(){

  console.log("⛔ إيقاف البث");

  if(pc){
    pc.close();
    pc = null;
  }

  if(remoteVideo){
    remoteVideo.srcObject = null;
    remoteVideo.style.display = "none";
  }

  if(liveStatus){
    liveStatus.innerHTML = "● غير متصل";
    liveStatus.classList.remove("live-on");
  }

  if(videoOverlay){
    videoOverlay.style.display = "flex";
  }

  liveStarted = false;
}

function captureFrame() {

  const video = document.getElementById("remoteVideo");
  const canvas = document.getElementById("canvas");

  if(!video || video.readyState < 2){
    alert("البث غير جاهز");
    return;
  }

  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;

  const ctx = canvas.getContext("2d");
  ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

  // تحويل الصورة
  canvas.toBlob(function(blob){

    const link = document.createElement("a");

    const url = URL.createObjectURL(blob);
    link.href = url;

    // اسم الملف
    link.download = "capture.png";

    // تحميل تلقائي
    document.body.appendChild(link);
    link.click();

    // تنظيف
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

  }, "image/png");
}

function goHome(){
  window.location.href = "/index"; // أو "/"
}
</script>

</body>
</html>